[%# INTERFACE:
  # target: string. URL to go to after login.
  #%]

[% IF !target %]
 [% target = "index.cgi" %]
[% END %]

[% PROCESS global/header.html.tmpl
  title = "Log in to $terms.Bugzilla"
  style_urls = ['skins/standard/global.css', 'skins/standard/modern-additional.css']
  javascript_urls = ['js/global.js']
%]

[% USE Bugzilla %]

<style>
  /* Modern login page styles */
  .login-container {
    max-width: 600px;
    margin: 20px auto;
    font-family: Arial, sans-serif;
    position: relative;
  }
  
  .tab-container {
    display: flex;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
  }
  
  .tab {
    padding: 15px 0;
    width: 50%;
    text-align: center;
    font-weight: bold;
    cursor: pointer;
  }
  
  .tab-active {
    background-color: #3f51b5;
    color: white;
  }
  
  .tab-inactive {
    background-color: #f0f0f0;
    color: #333;
  }
  
  .login-form-container {
    padding: 20px 30px 30px;
    border: 1px solid #ddd;
    border-radius: 0 0 8px 8px;
    background-color: white;
  }
  
  .login-title {
    font-size: 24px;
    color: #3f51b5;
    text-align: center;
    margin-bottom: 25px;
  }
  
  .form-group {
    margin-bottom: 20px;
  }
  
  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    color: #333;
  }
  
  .form-control {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 16px;
    box-sizing: border-box;
  }
  
  .checkbox-group {
    display: flex;
    align-items: center;
    margin-bottom: 15px;
  }
  
  .checkbox-group input {
    margin-right: 8px;
  }
  
  .login-button {
    display: block;
    width: 100%;
    padding: 14px;
    background-color: #3f51b5;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
    margin-top: 20px;
  }
  
  .login-button:hover {
    background-color: #303f9f;
  }
  
  .create-account {
    text-align: center;
    margin-top: 20px;
  }
  
  .create-account a {
    color: #3f51b5;
    text-decoration: none;
  }
  
  .create-account a:hover {
    text-decoration: underline;
  }
  
  .forgot-password-form {
    display: none; 
  }
  
  .close-button {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 24px;
    cursor: pointer;
    color: #999;
  }
</style>

<div class="login-container">
  <div class="tab-container">
    <div id="login-tab" class="tab tab-active" onclick="switchTab('login')">Login</div>
    <div id="forgot-tab" class="tab tab-inactive" onclick="switchTab('forgot')">Forgot Password</div>
    <span class="close-button" onclick="window.location='index.cgi'">&times;</span>
  </div>
  
  <div class="login-form-container">
    <div id="login-form-section">
      <h2 class="login-title">Log in to [% terms.Bugzilla %]</h2>
      
      <form name="login" action="[% urlbase FILTER html %][% target FILTER html %]" method="POST"
      [%- IF Bugzilla.cgi.param("data") %] enctype="multipart/form-data"[% END %]>
        <div class="form-group">
          <label for="Bugzilla_login">
            [% IF login_not_email %]
              Login
            [% ELSE %]
              Email Address
            [% END %]
          </label>
          <input class="form-control" id="Bugzilla_login" name="Bugzilla_login" 
                 placeholder="Enter your email"
                 [%- ' type="email"' UNLESS login_not_email %] autofocus required>
          [% Param('emailsuffix') FILTER html %]
        </div>
        
        <div class="form-group">
          <label for="Bugzilla_password">Password</label>
          <input type="password" class="form-control" id="Bugzilla_password" 
                 name="Bugzilla_password" placeholder="Enter your password" required>
        </div>

        [% IF Param('rememberlogin') == 'defaulton' || 
              Param('rememberlogin') == 'defaultoff' %]
          <div class="checkbox-group">
            <input type="checkbox" id="Bugzilla_remember" name="Bugzilla_remember" value="on"
                   [%+ "checked" IF Param('rememberlogin') == "defaulton" %]>
            <label for="Bugzilla_remember">Remember my Login</label>
          </div>
        [% END %]

        <div class="checkbox-group">
          <input type="checkbox" id="Bugzilla_restrictlogin" name="Bugzilla_restrictlogin"
                 checked="checked">
          <label for="Bugzilla_restrictlogin">Restrict this session to this IP address</label>
        </div>

        [% PROCESS "global/hidden-fields.html.tmpl"
           exclude="^Bugzilla_(login|password|restrictlogin)$" %]

        <input type="hidden" name="Bugzilla_login_token"
               value="[% get_login_request_token() FILTER html %]">
        <input type="submit" class="login-button" name="GoAheadAndLogIn" value="Log In" id="log_in">
        
        [% IF Param("createemailregexp") && user.authorizer.user_can_create_account %]
          <div class="create-account">
            Don't have an account? <a href="createaccount.cgi">Create one</a>
          </div>
        [% END %]
      </form>
    </div>
    
    [% IF user.authorizer.can_change_password %]
      <div id="forgot-form-section" class="forgot-password-form">
        <h2 class="login-title">Reset Your Password</h2>
        
        <form id="forgot" method="post" action="token.cgi">
          <div class="form-group">
            <label for="loginname">
              [% IF login_not_email %]
                Login Name
              [% ELSE %]
                Email Address
              [% END %]
            </label>
            <input class="form-control" id="loginname" name="loginname" 
                   placeholder="Enter your email address" required>
          </div>
          
          <input type="hidden" name="a" value="reqpw">
          <input type="hidden" id="token" name="token" value="[% issue_hash_token(['reqpw']) FILTER html %]">
          <input type="submit" id="request" value="Reset Password" class="login-button">
          
          [% IF Param("createemailregexp") && user.authorizer.user_can_create_account %]
            <div class="create-account">
              Don't have an account? <a href="createaccount.cgi">Create one</a>
            </div>
          [% END %]
        </form>
      </div>
    [% END %]
  </div>
</div>

<script>
  // Function to switch between login and forgot password tabs
  function switchTab(tabName) {
    if (tabName === 'login') {
      // Update tab styles
      document.getElementById('login-tab').classList.add('tab-active');
      document.getElementById('login-tab').classList.remove('tab-inactive');
      document.getElementById('forgot-tab').classList.add('tab-inactive');
      document.getElementById('forgot-tab').classList.remove('tab-active');
      
      // Show login form, hide forgot password form
      document.getElementById('login-form-section').style.display = 'block';
      document.getElementById('forgot-form-section').style.display = 'none';
    } else if (tabName === 'forgot') {
      // Update tab styles
      document.getElementById('login-tab').classList.add('tab-inactive');
      document.getElementById('login-tab').classList.remove('tab-active');
      document.getElementById('forgot-tab').classList.add('tab-active');
      document.getElementById('forgot-tab').classList.remove('tab-inactive');
      
      // Show forgot password form, hide login form
      document.getElementById('login-form-section').style.display = 'none';
      document.getElementById('forgot-form-section').style.display = 'block';
    }
    
    return false; // Prevent default behavior
  }

  // Check if we should show the forgot password form on page load
  if (window.location.hash === '#forgot') {
    switchTab('forgot');
  }